# Скопируйте файл в .env и укажите свои значения.

# Провайдер LLM: openai (любой OpenAI-совместимый API) или ollama (открытые модели локально)
LLM_PROVIDER=openai

# ---- OpenAI-совместимый API ----
OPENAI_API_KEY=
# Адрес API, если используется не OpenAI напрямую (ProxyAPI, OpenRouter, vLLM, LM Studio и т. п.)
# OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1

# ---- Ollama (открытые LLM) ----
OLLAMA_BASE_URL=http://localhost:11434
# Размер контекстного окна модели в токенах
NUM_CTX=8192

# Модели (если не указаны, берутся значения по умолчанию для провайдера)
# openai: gpt-4.1-mini / gpt-4.1-mini / text-embedding-3-small
# ollama: qwen2.5:7b / qwen2.5vl:7b / bge-m3
# CHAT_MODEL=
# VISION_MODEL=
# EMBEDDINGS_PROVIDER=   # openai, ollama или none (только поиск BM25)
# EMBEDDING_MODEL=

TEMPERATURE=0.3
MAX_ANSWER_TOKENS=1500
# Бюджет токенов истории диалога, передаваемой модели
HISTORY_TOKENS=2000
# Число фрагментов методичек в контексте RAG
TOP_K=4

# Распознавание речи: local (faster-whisper на компьютере), openai (Whisper API)
# или auto (основной способ и резервный: при ошибке одного используется другой)
STT_ENGINE=auto
STT_MODEL=whisper-1
# Модель Whisper: tiny, base, small, medium, large-v3 или путь к папке со скачанной моделью.
# Скачивается один раз при первом запуске; заранее: python scripts/check_speech.py
WHISPER_SIZE=small
# Зеркало Hugging Face, если huggingface.co недоступен (нужно только для скачивания модели)
# HF_ENDPOINT=https://hf-mirror.com
# Голос синтеза речи: ru-RU-SvetlanaNeural или ru-RU-DmitryNeural
TTS_VOICE=ru-RU-SvetlanaNeural

# ---- Трассировка цепочек и агентов в LangSmith (необязательно) ----
# Показывает промпты, найденные фрагменты, вызовы инструментов и ответы модели
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=labmentor
